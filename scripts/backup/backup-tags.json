{
  "tags": {
    "docker": {
      "job_description": "Docker folder Backup (and snapshots) - pre and post, retention policy",
      "backup_path": "/volume1/docker/.snapshots/docker",
      "pre_script": "btrfs subvolume snapshot -r /volume1/docker/ /volume1/docker/.snapshots/docker",
      "post_script": "btrfs subvolume delete /volume1/docker/.snapshots/docker",
      "keep": {
        "daily": 7,
        "weekly": 4,
        "monthly": 6
      }
    },
    "has_spaces": {
      "job_description": "This example has spaces in the path - retention policy",
      "backup_path": "/volume1/Spaces in this Folder Name",
      "keep": {
        "daily": 14,
        "weekly": 8,
        "monthly": 12,
        "yearly": 2
      }
    },
    "backup": {
      "job_description": "Backup of the Backup folder - no pre or post, no retention policy",
      "backup_path": "/volume1/Backup"
    },
    "home": {
      "job_description": "Backup user home folders - large retention policy",
      "backup_path": "/home",
      "keep": {
        "daily": 14,
        "weekly": 8,
        "monthly": 12,
        "yearly": 2
      }
    },
    "media": {
      "job_description": "Media folder Backup - excludes, and retention policy",
      "backup_path": "/volume1/Media",
      "excludes": [
        "**/Family Movies",
        "**/3D Movies",
        "**/Large Movies",
        "**/TV Series",
        "**/downloads",
        "**/DVR"
      ],
      "keep": {
        "daily": 7,
        "weekly": 4,
        "monthly": 6
      }
    },
    "rootfs": {
      "job_description": "Root Filesystem Backup - large retention policy",
      "backup_path": "/",
      "keep": {
        "daily": 14,
        "weekly": 8,
        "monthly": 12,
        "yearly": 2
      }
    }
  }
}